# Backend Environment Variables
# Copy this file to .env and customize values for your environment

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# File Upload Configuration
# Maximum file size in megabytes (default: 100)
MAX_FILE_SIZE_MB=100

# Admin API Key (for /stats endpoint)
# Generate a secure random key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your-secure-api-key-here

# Database Configuration
# Path to SQLite database (default: analytics/analytics.db)
# DB_PATH=/path/to/custom/analytics.db

# Logging Configuration
# LOG_LEVEL=INFO

# Server Configuration (for production)
# HOST=0.0.0.0
# PORT=8000
# WORKERS=4
